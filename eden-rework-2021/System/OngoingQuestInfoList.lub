	},
	[21219] = { -- iRO, corrected
		Title = "Mummies and the Blue Box",
		Description = {
			"At the request of Team Leader Maxim and his team, who still can't let go of the blue box, you have been asked to ^4d4dffdefeat 10 Mummies and bring back 1 Memento^000000.",
		},
		Summary = "1 Memento",
		IconName = "ico_dq.bmp",
	},
	[21220] = { -- iRO, corrected
		Title = "An Unbreakable Dream",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21221] = { -- iRO, corrected
		Title = "It's All Experience 1",
		Description = {
			"To get used to taking requests from others, you accepted a request to defeat ^4d4dffPeco Peco^000000 and ^4d4dffMuka^000000 in <NAVI>[Sograt Desert 01]<INFO>moc_fild01,253,357,0,101,0</INFO></NAVI>. <NAVI>[Instructor Fontes]<INFO>izlude,132,207,0,101,0</INFO></NAVI> says this kind of give and take is how you become a true adventurer...",
		},
		Summary = "Defeat Peco Peco and Muka",
	},
	[21222] = { -- iRO, corrected
		Title = "The Noisy Ones",
		Description = {
			"You decided to start taking requests from local residents in earnest. First is the Peco Peco and Muka hunt you took earlier for practice. Most complaints come from <NAVI>[Sograt Desert 01]<INFO>moc_fild01,253,357,0,101,0</INFO></NAVI>, and every one of them says they're 'noisy.'",
		},
		Summary = "Defeat Peco Peco and Muka",
		IconName = "ico_dq.bmp",
	},
	[21223] = { -- iRO, corrected
		Title = "The Noisy Ones - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21224] = { -- iRO, corrected
		Title = "It's All Experience 2",
		Description = {
			"A request Instructor Fontes brought for training. Leave Izlude and defeat the Magnolia and Metaller that appear in <NAVI>[Prontera Field 09]<INFO>prt_fild09,380,237,0,101,0</INFO></NAVI>, southwest of Izlude. If you've hunted Muka and Peco Peco before, you'll recognize it as the neighboring field.",
		},
		Summary = "Defeat Magnolia and Metaller",
	},
	[21225] = { -- iRO, corrected
		Title = "Eggs and Grasshoppers",
		Description = {
			"A request Instructor Fontes brought for training. Leave Izlude and defeat the Magnolia and Metaller that appear in <NAVI>[Prontera Field 09]<INFO>prt_fild09,380,237,0,101,0</INFO></NAVI>, southwest of Izlude. If you've hunted Muka and Peco Peco before, you'll recognize it as the neighboring field.",
		},
		Summary = "Defeat Magnolia and Metaller",
		IconName = "ico_dq.bmp",
	},
	[21226] = { -- iRO, corrected
		Title = "Eggs and Grasshoppers - Cooldown",
