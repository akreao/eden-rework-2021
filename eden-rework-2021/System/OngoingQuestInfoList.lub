	[21301] = { -- official iRO
		Title = "Please Say Hello to My Brother",
		Description = {
			"This is a letter from Ernst, a student at Kiel Hyre Academy, to his older brother Friedrich. <NAVI>[Friedrich]<INFO>ein_fild06,163,173,0,101,0</INFO></NAVI> is said to be working in the factory district west of the Abyss Valley.",
		},
		Summary = "Talk to Friedrich",
	},
	[21302] = { -- iRO, corrected
		Title = "Please Help Clean Up the Area",
		Description = {
			"At Friedrich's request, you decided to clean up the area around the factory by defeating Metaling and Holden, which dig around the buildings or eat and damage equipment.",
