			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21269] = { -- iRO, corrected
		Title = "Troublesome Creatures",
		Description = {
			"Some Goblins have expanded their territory as far as <NAVI>[Prontera Field 11]<INFO>prt_fild11,26,281,0,101,0</INFO></NAVI>, east of the Goblin settlement. Subjugation Deputy Leader orders you to defeat the Goblins, saying that their further territorial expansion must be stopped.",
		},
		Summary = "Defeat Morningstar Goblins and Goblin Archers",
		IconName = "ico_dq.bmp",
	},
	[21270] = { -- iRO, corrected
		Title = "Troublesome Creatures - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21271] = { -- official iRO
		Title = "The Whereabouts of the Acolyte",
		Description = {
			"Lars of Prontera Cathedral says that he has lost contact with <NAVI>[Claude]<INFO>glast_01,205,131,0,101,0</INFO></NAVI>, the priest who left on a mission to cleanse the Glast Heim castle monastery. He is worried about him.",
		},
		Summary = "",
	},
	[21272] = { -- iRO, corrected
		Title = "Cleansing the Monastery",
		Description = {
			"Claude asks you to deal with the undead Wraiths and Evil Druids inside the monastery. If you meet a priest conducting purification activities inside, you may be able to receive some assistance.",
		},
		Summary = "Defeat Wraiths and Evil Druids",
		IconName = "ico_dq.bmp",
	},
	[21273] = { -- iRO, corrected
		Title = "Cleansing the Monastery - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21274] = { -- iRO, corrected
		Title = "Stabilizing the Underground Cemetery",
		Description = {
			"The former priests buried in the monastery's underground cemetery have awakened as undead and are causing trouble. Help cleanse the monastery by defeating the Dark Priests and Furious Dark Priests.",
		},
		Summary = "Defeat Dark Priests and Furious Dark Priests",
		IconName = "ico_dq.bmp",
	},
	[21275] = { -- iRO, corrected
		Title = "Stabilizing the Underground Cemetery - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21276] = { -- iRO, corrected
		Title = "A Mother's Homemade Lunch",
		Description = {
			"An older woman you met in Aldebaran asks you to deliver a packed lunch to her son, who works at the border checkpoint. The border checkpoint, <NAVI>[Schwarzwald Border Checkpoint 01]<INFO>yuno_fild01,196,154,0,101,0</INFO></NAVI>, is located north of Aldebaran.",
		},
		Summary = "Talk to the Checkpoint Guard",
		IconName = "ico_dq.bmp",
	},
	[21277] = { -- iRO, corrected
		Title = "Business at the Border Checkpoint",
		Description = {
			"Cesare, the commander of the border checkpoint, says that it is too difficult for his limited staff to handle travelers' complaints as well. He asks you to resolve the complaints in his place. Defeat the monsters in the fields near the checkpoint.",
		},
		Summary = "Defeat Geographers and Mantis",
		IconName = "ico_dq.bmp",
	},
	[21278] = { -- iRO, corrected
		Title = "Business at the Border Checkpoint - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21279] = { -- iRO, corrected
		Title = "Soft and Fluffy",
		Description = {
			"A girl you met at the border checkpoint asked you to gather ^4d4dff5 Antelope Skins and 5 Peco Peco Feathers^000000 as materials for making soft blankets and pillows, then bring them to <NAVI>[Kiel Hyre Academy, Juno]<INFO>yuno_fild08,179,200,0,101,0</INFO></NAVI>. She says that she is a student there.",
		},
		Summary = "5 Antelope Skins, 5 Peco Peco Feathers",
	},
	[21280] = { -- iRO, corrected
		Title = "Improving Academy Security",
		Description = {
			"The <NAVI>[Guard]<INFO>yuno_fild08,198,200,0,101,0</INFO></NAVI> responsible for the safety of Kiel Hyre Academy is troubled because many people are being attacked by Harpies and Sleepers in the field between the academy and the villa. He asks you to defeat the Harpies and Sleepers.",
		},
		Summary = "Defeat Harpies and Sleepers",
		IconName = "ico_dq.bmp",
	},
	[21281] = { -- official iRO
		Title = "Improving Academy Security - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group bulletin board or the <NAVI>[Guard]<INFO>yuno_fild08,198,200,0,101,0</INFO></NAVI> at Kiel Hyre Academy.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21282] = { -- iRO, corrected
		Title = "A Groundbreaking Business Idea",
		Description = {
			"Cat Hand Merchant, whom you met in front of Kiel Hyre Academy, asks you to gather ^4d4dff10 Antelope Skins and 10 Peco Peco Feathers^000000. It seems that the merchant plans to sell blankets and pillows to the students.",
		},
		Summary = "10 Antelope Skins, 10 Peco Peco Feathers",
		IconName = "ico_dq.bmp",
	},
	[21283] = { -- iRO, corrected
		Title = "A Groundbreaking Business Idea - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21284] = { -- iRO, corrected
		Title = "A Proper Finishing Touch",
		Description = {
			"A female student who was watching the Cat Hand Merchant accept a request at <NAVI>[Kiel Hyre Academy, Juno]<INFO>yuno_fild08,179,200,0,101,0</INFO></NAVI> made an additional request. Grand Pecos and Goats have entered the academy grounds, so she asks you to completely eliminate them.",
		},
		Summary = "Defeat Goats and Grand Pecos",
		IconName = "ico_dq.bmp",
	},
	[21285] = { -- iRO, corrected
		Title = "A Proper Finishing Touch - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21286] = { -- iRO, corrected
		Title = "Cleaning the Clock Tower's First Floor",
		Description = {
			"This is a request from <NAVI>[Cerdin]<INFO>aldebaran,143,132,0,101,0</INFO></NAVI>, the Aldebaran Clock Tower administrator. He asks you to help clean the clock tower by defeating the ^4d4dffRidewords^000000, books that have become monsters, and the dust ^4d4dffPunks^000000 on <NAVI>[Al De Baran Clock Tower Floor 1]<INFO>c_tower1,200,192,0,101,0</INFO></NAVI>.",
		},
		Summary = "Defeat Ridewords and Punks",
		IconName = "ico_dq.bmp",
	},
	[21287] = { -- official iRO
		Title = "Cleaning the Clock Tower's First Floor - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group bulletin board or <NAVI>[Cerdin]<INFO>aldebaran,143,132,0,101,0</INFO></NAVI>, the Clock Tower administrator in Aldebaran.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21288] = { -- iRO, corrected
		Title = "The Living, Moving Clock 1",
		Description = {
			"There are small clocks in the Clock Tower that move on their own. <NAVI>[Cerdin]<INFO>aldebaran,143,132,0,101,0</INFO></NAVI>, the Clock Tower administrator, says that those who have forgotten the purpose of a clock do not deserve forgiveness and asks you to destroy them. Clocks mainly appear on <NAVI>[Al De Baran Clock Tower Floor 2]<INFO>c_tower2,263,26,0,101,0</INFO></NAVI>.",
		},
		Summary = "Defeat Clocks",
		IconName = "ico_dq.bmp",
	},
	[21289] = { -- official iRO
		Title = "The Living, Moving Clock 1 - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group bulletin board or <NAVI>[Cerdin]<INFO>aldebaran,143,132,0,101,0</INFO></NAVI>, the Clock Tower administrator in Aldebaran.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21290] = { -- iRO, corrected
		Title = "The Living, Moving Clock 2",
		Description = {
			"Besides Clocks, there was one more kind of moving clock in the Clock Tower. It is more troublesome than the Clock, constantly ringing its alarm. You are asked to defeat Alarms. Alarms mainly appear on <NAVI>[Al De Baran Clock Tower Floor 3]<INFO>c_tower3,66,145,0,101,0</INFO></NAVI>.",
		},
		Summary = "Defeat Alarms",
		IconName = "ico_dq.bmp",
	},
	[21291] = { -- official iRO
		Title = "The Living, Moving Clock 2 - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group bulletin board or <NAVI>[Cerdin]<INFO>aldebaran,143,132,0,101,0</INFO></NAVI>, the Clock Tower administrator in Aldebaran.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21292] = { -- iRO, corrected
		Title = "Laughter Echoing from Underground",
		Description = {
			"There is a dungeon beneath Aldebaran that is said to be connected to the Clock Tower basement, <NAVI>[Al De Baran Clock Tower Underground Floor 4]<INFO>alde_dun04,80,265,0,101,0</INFO></NAVI>. The sound of a witch laughing deep underground torments <NAVI>[Cerdin]<INFO>aldebaran,143,132,0,101,0</INFO></NAVI>. He suspects that the witch may be responsible for the Clock Tower's condition and asks you to defeat her.",
		},
		Summary = "Defeat Bathory",
		IconName = "ico_dq.bmp",
	},
	[21293] = { -- official iRO
		Title = "Laughter Echoing from Underground - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group bulletin board or <NAVI>[Cerdin]<INFO>aldebaran,143,132,0,101,0</INFO></NAVI>, the Clock Tower administrator in Aldebaran.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21294] = { -- iRO, corrected
		Title = "A Noble War",
		Description = {
			"<NAVI>[Fisher Ain]<INFO>hugel,100,149,0,101,0</INFO></NAVI> of Hugel says that the Crabs and Asters washing ashore on the beach at <NAVI>[Hugel Field 06]<INFO>hu_fild06,200,364,0,101,0</INFO></NAVI> keep damaging his prepared fishing nets, forcing him to repair them every time. He asks you to defeat the Crabs and Asters to keep the nets from being damaged.",
		},
		Summary = "Defeat Crabs and Asters",
		IconName = "ico_dq.bmp",
	},
	[21295] = { -- iRO, corrected
		Title = "Clam-Digging Experience",
		Description = {
			"<NAVI>[Fisher Ain]<INFO>hugel,100,149,0,101,0</INFO></NAVI> of Hugel suggests that, since you have come to Hugel, a seaside resort, you should experience life in a fishing village firsthand by gathering clams. Hunt Shellfish on the beach at <NAVI>[Hugel Field 06]<INFO>hu_fild06,200,364,0,101,0</INFO></NAVI> and bring back the Clam Flesh so he can prepare a delicious dish for you.",
		},
		Summary = "5 Clam Flesh",
		IconName = "ico_dq.bmp",
	},
	[21296] = { -- iRO, corrected
		Title = "The Culprits Behind the Water Pipe Damage",
		Description = {
			"<NAVI>[Dry]<INFO>hugel,91,142,0,101,0</INFO></NAVI>, who is in charge of Hugel's water supply, says that the Novuses keep damaging the water pipes connected to <NAVI>[Abyss Lake, Hugel]<INFO>hu_fild05,335,153,0,101,0</INFO></NAVI>, causing trouble. He asks you to defeat the Novuses around the lake.",
		},
		Summary = "Defeat Red Novus and Yellow Novus",
		IconName = "ico_dq.bmp",
	},
	[21297] = { -- official iRO
		Title = "A Noble War - Cooldown",
		Description = {
