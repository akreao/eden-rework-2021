	},
	[21255] = { -- official iRO
		Title = "Regular Monster Subjugation Cooperation Notice",
		Description = {
			"The Prontera Knights conduct ^4d4dffregular subjugation operations^000000 to prevent ^4d4dffOrcs and Goblins^000000 from expanding their territory into the areas surrounding Prontera.",
		},
		Summary = "Talk to the Knights' Office Worker",
	},
	[21256] = { -- iRO, corrected
		Title = "Orcs, Wipe Them All Out!",
		Description = {
			"You joined the Orc subjugation operation. Subjugation Leader shouted confidently, \"Let's wipe out the entire ^4d4dffOrc Warrior, Orc Lady, and Orc Baby^000000 family!\" Live up to his expectations and wipe them all out!",
		},
		Summary = "Defeat Orc Warriors, Orc Ladies, and Orc Babies",
		IconName = "ico_dq.bmp",
	},
	[21257] = { -- iRO, corrected
		Title = "Orcs, Wipe Them All Out! - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21258] = { -- iRO, corrected
		Title = "Those Tiresome Orcs",
		Description = {
			"Orc Zombies and Orc Skeletons, who have become undead, inhabit the underground tunnels beneath Orc Village. Wipe out these unholy Orcs as well. Then report to the Eden Group Board.",
		},
		Summary = "Defeat Orc Zombies and Orc Skeletons",
		IconName = "ico_dq.bmp",
	},
	[21259] = { -- iRO, corrected
		Title = "Those Tiresome Orcs - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21260] = { -- iRO, corrected
		Title = "The Greedy One",
		Description = {
			"On the second floor of the underground tunnels beneath Orc Village lives a mutated Orc named \"Zenorc,\" transformed by excessive greed and a lack of sunlight. Defeat this greedy creature. Then report to the Eden Group Board.",
		},
		Summary = "Defeat Zenorc",
		IconName = "ico_dq.bmp",
	},
	[21261] = { -- iRO, corrected
		Title = "The Greedy One - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21262] = { -- iRO, corrected
		Title = "Clearing Out the Fierce Goblins",
		Description = {
			"South of Orc Village, Goblins have formed a small settlement. Subjugation Deputy Leader says that, like the Orcs, these monsters must be stopped from expanding their territory, and asks you to help with the Goblin subjugation.",
		},
		Summary = "Defeat Axe Goblins and Flail Goblins",
		IconName = "ico_dq.bmp",
	},
	[21263] = { -- iRO, corrected
		Title = "Clearing Out the Fierce Goblins - Cooldown",
		Description = {
