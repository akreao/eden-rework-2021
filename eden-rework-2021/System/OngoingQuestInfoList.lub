	[21196] = { -- official iRO
		Title = "Opening in the Temple",
		Description = {
			"You've found the opening to the Sanctuary!",
		},
		Summary = "",
	},
	[21201] = { -- iRO, corrected
		Title = "Finding the Lost Child",
		Description = {
			"The old scholar you met in Morroc asked you to find his <NAVI>[Apprentice]<INFO>moc_fild17,358,277,0,101,0</INFO></NAVI>, who went off alone to find the Assassin Guild. Head to the desert southeast of Morroc, where the Assassin Guild is said to be.",
		},
		Summary = "Talk to the Apprentice",
	},
	[21202] = { -- iRO, corrected
		Title = "Those Blocking the Way",
		Description = {
			"The old scholar's Apprentice, whom you found in a corner of the desert, says he can't go any further because of the Sandmen, and asks you to defeat them and collect ^4d4dff5 Grit^000000.",
		},
		Summary = "5 Grit",
		IconName = "ico_dq.bmp",
	},
	[21203] = { -- iRO, corrected
		Title = "Lost, Not Lost, Yet Like a Lost Child",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21204] = { -- iRO, corrected
		Title = "Giving Up an Item for a Backache",
		Description = {
			"At the oasis in front of the Pyramid outside Morroc, the <NAVI>[Old Scholar]<INFO>moc_ruins,104,122,0,101,0</INFO></NAVI> asks you to find the ^4d4dffField Shovel^000000 a Verit carried off into the Pyramid's basement. Defeating Verits and Minorous along the way is a bonus.",
		},
		Summary = "1 Field Shovel",
	},
	[21205] = { -- iRO, corrected
		Title = "I Can't Sleep",
		Description = {
			"A request from Lumin, who lives in the Thieves Guild. The guild members are bothered by the Verits and Minorous living beneath the guild. Defeat the Verits and Minorous.",
		},
		Summary = "",
		IconName = "ico_dq.bmp",
	},
	[21206] = { -- iRO, corrected
		Title = "Sleep Isn't Just for One Night, Is It?",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21207] = { -- iRO, corrected
		Title = "The Whereabouts of Friends Beyond the Maze 1",
		Description = {
			"<NAVI>[Ernest]<INFO>moc_ruins,101,124,0,101,0</INFO></NAVI> got separated from the friends who came with him to do their assignment, and asks you to find his <NAVI>[friends]<INFO>moc_pryd01,20,192,0,101,0</INFO></NAVI> who went into the Pyramid and give them his news. Climb up the Pyramid slowly.",
		},
		Summary = "Talk to Team Leader Maxim",
	},
	[21208] = { -- iRO, corrected
		Title = "The Old Blue Box and a Sweet Dream",
		Description = {
			"<NAVI>[Ernest's friends]<INFO>moc_pryd01,20,192,0,101,0</INFO></NAVI> believe the Memento is an Old Blue Box. They want you to hunt Mummies, get a Memento, and check again...",
		},
		Summary = "1 Memento",
	},
	[21209] = { -- iRO, corrected
		Title = "The Whereabouts of Friends Beyond the Maze 2",
		Description = {
			"Tell <NAVI>[Ernest]<INFO>moc_ruins,101,124,0,101,0</INFO></NAVI>, who will be waiting at the oasis, all about <NAVI>[Team Leader Maxim]<INFO>moc_pryd01,20,192,0,101,0</INFO></NAVI> and the friends. Tell it well!",
		},
		Summary = "Talk to Ernest",
	},
	[21210] = { -- iRO, corrected
		Title = "What Isis Has",
		Description = {
			"<NAVI>[Ernest]<INFO>moc_ruins,101,124,0,101,0</INFO></NAVI> says he needs a little something to unlock the secret of the Pyramid. He asks you to defeat Isis and bring him the unusual item she carries.",
		},
		Summary = "1 Rotten Bandage",
	},
	[21211] = { -- iRO, corrected
		Title = "The Workers of the Sphinx",
		Description = {
			"<NAVI>[Ernest]<INFO>moc_ruins,101,124,0,101,0</INFO></NAVI> has had more and more requests since he started researching with the old scholar. This time, to investigate how the Pyramid and the Sphinx are related, he wants you to see ^4d4dffZerom and Requiem^000000 for yourself and tell him about them...",
		},
		Summary = "",
	},
	[21212] = { -- iRO, corrected
		Title = "Secrets of the Sphinx",
		Description = {
			"You have been asked to investigate the ^4d4dffMarduk and Pasana^000000 that appear on the upper floors of the Sphinx. Be sure to grab anything Marduk carries that could serve as research material.",
		},
		Summary = "1 Old Papyrus",
	},
	[21213] = { -- iRO, corrected
		Title = "Defeat Isis",
		Description = {
			"You have been asked to defeat the Isis that hinder smooth exploration. Isis appear mostly on the 2nd and 4th floors of the Pyramid.",
		},
		Summary = "",
		IconName = "ico_dq.bmp",
	},
	[21214] = { -- iRO, corrected
		Title = "Defeat Isis - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21215] = { -- iRO, corrected
		Title = "Defeat the Sphinx's Workers",
		Description = {
			"You have been asked to defeat the Zerom and Requiem that hinder the investigation inside the Sphinx. Zerom and Requiem mostly appear on the 1st and 2nd floors of the Sphinx.",
		},
		Summary = "",
		IconName = "ico_dq.bmp",
	},
	[21216] = { -- iRO, corrected
		Title = "Defeat the Sphinx's Workers - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
