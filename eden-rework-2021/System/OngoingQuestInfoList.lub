		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21217] = { -- iRO, corrected
		Title = "Secrets of the Sphinx",
		Description = {
			"It seems more of the 'Old Papyrus' that Marduk carries is needed. While you're at it, you have also been asked to defeat Pasana to make exploration smoother.",
		},
		Summary = "10 Old Papyrus",
		IconName = "ico_dq.bmp",
	},
	[21218] = { -- iRO, corrected
		Title = "Secrets of the Sphinx - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
