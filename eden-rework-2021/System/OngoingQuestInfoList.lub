-- Eden Group quest text in English, for the Eden 2021 rework mod (Ragnarok Offline).
-- Covers every Eden-linked quest and cooldown entry in the kRO client (build 2025-12-03), plus the town quests the mission boards use.
-- Source per entry: "official iRO" = verbatim from the iRO client (patched 2026-10-07); "iRO, corrected" = iRO text with errors
-- fixed against the Korean; "translated" = translated from kRO for this mod. Links use kRO's own targets; maps use unique names.
-- Ship as System/OngoingQuestInfoList.lub in a mod. ASCII only: the client reads this table in its own codepage.

QuestInfoList = {
	[17528] = { -- translated
		Title = "Eden Group Basic Equipment",
		Description = {
			"Go meet the administrators who will keep supplying you with equipment. It's best to start with <NAVI>[Thorn]<INFO>moc_para01,110,87,0,101,0,</INFO></NAVI>, the administrator in charge of armor.",
		},
		Summary = "Administrator Thorn",
		IconName = "ico_nq.bmp",
	},
	[17529] = { -- translated
		Title = "Eden Group Basic Equipment",
		Description = {
			"Next, go meet <NAVI>[Michael]<INFO>moc_para01,110,83,0,101,0,</INFO></NAVI>, who handles advanced weapons.",
		},
		Summary = "Administrator Michael",
		IconName = "ico_nq.bmp",
	},
	[17530] = { -- translated
		Title = "Eden Group Basic Equipment",
		Description = {
			"Now it's time to get equipment you can use right away. Go see <NAVI>[BK]<INFO>moc_para01,110,79,0,101,0,</INFO></NAVI>.",
		},
		Summary = "Administrator BK",
		IconName = "ico_nq.bmp",
	},
	[17531] = { -- translated
		Title = "Eden Group Basic Equipment",
		Description = {
			"Go to <NAVI>[Ur]<INFO>moc_para01,23,31,0,101,0,</INFO></NAVI> and report that you have received all of your basic equipment.",
		},
		Summary = "Report to Instructor Ur",
		IconName = "ico_nq.bmp",
	},
	[17532] = { -- translated
		Title = "Eden Group Shadow Equipment",
		Description = {
			"If you would like more equipment, talk to <NAVI>[Boya]<INFO>moc_para01,25,31,0,101,0,</INFO></NAVI>.",
		},
		Summary = "Talk to Instructor Boya",
		IconName = "ico_nq.bmp",
	},
	[17533] = { -- translated
		Title = "Eden Group Shadow Equipment",
		Description = {
			"If you need shadow equipment, go see Administrator <NAVI>[Emil]<INFO>moc_para01,110,91,0,101,0,</INFO></NAVI> in the armory.",
		},
		Summary = "Administrator Emil",
		IconName = "ico_nq.bmp",
	},
	[17534] = { -- translated
		Title = "Eden Group Shadow Equipment",
		Description = {
			"Report to <NAVI>[Boya]<INFO>moc_para01,25,31,0,101,0,</INFO></NAVI> that you received your shadow equipment. There will be trouble if the handout isn't on record.",
		},
		Summary = "Report to Instructor Boya",
		IconName = "ico_nq.bmp",
	},
	[17535] = { -- translated
		Title = "Eden Group Basic Equipment",
		Description = {
			"If you don't have decent basic equipment, talk to <NAVI>[Ur]<INFO>moc_para01,23,31,0,101,0,</INFO></NAVI>, the instructor right next to me, about getting some.",
		},
		Summary = "Talk to Instructor Ur",
		IconName = "ico_nq.bmp",
	},
	[17536] = { -- translated
		Title = "Eden Group Advanced Equipment",
		Description = {
			"Bring 15 Elastic Bands and 3 Blue Hair to <NAVI>[Thorn]<INFO>moc_para01,110,87,0,101,0,</INFO></NAVI> to receive advanced armor.",
		},
		Summary = "Armor materials",
		IconName = "ico_nq.bmp",
	},
	[17537] = { -- translated
		Title = "Eden Group Advanced Equipment",
		Description = {
			"Bring 15 Old Picks to <NAVI>[Michael]<INFO>moc_para01,110,83,0,101,0,</INFO></NAVI> and he will give you an advanced weapon.",
		},
		Summary = "Weapon materials",
		IconName = "ico_nq.bmp",
	},
	[19000] = { -- translated
		Title = "Blooming Flower Land",
		Description = {
			"This is an exclusive Eden Group request.",
			"Defeat monsters in the <NAVI>[Blooming Flower Land]<INFO>ecl_fild01,182,93,0,101,0</INFO></NAVI> area, then report to the Advanced Request Board.",
			"^FF0000* There may be requirements for entering this area.^000000",
		},
		Summary = "Defeat monsters in Blooming Flower Land",
		IconName = "ico_dq.bmp",
	},
	[19001] = { -- translated
		Title = "Blooming Flower Land - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Advanced Request Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
