		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21001] = { -- iRO, corrected
		Title = "Shipwreck Escape",
		Description = {
			"Your ship was caught in a storm during your travels and wrecked on a deserted island, and you must escape. Let the captain know that there are still injured people on board.",
		},
		Summary = "Talk to the captain",
	},
	[21002] = { -- iRO, corrected
		Title = "First Battle",
		Description = {
			"You have been asked to catch the Poring that stole the ship's repair materials, recover 2 Wood, and deliver it to the sailor. Defeat Porings nearby and recover the Wood.",
		},
		Summary = "Deliver 2 Wood to the sailor",
	},
	[21003] = { -- iRO, corrected
		Title = "Something for Motion Sickness",
		Description = {
			"You decided to find something to drink for your friend Leno, whom you met while traveling, to ease his motion sickness. Ask the ^4d4dffhealer about herbs^000000 at the ^4d4dffCriatura Academy infirmary^000000.",
		},
		Summary = "Ask the healer about herbalism",
	},
	[21004] = { -- iRO, corrected
		Title = "Basic Herbalism",
		Description = {
			"The healer suggests you dig up a Red Herb, a potion ingredient, yourself. Find the ^4d4dffred grass^000000 ^4d4dffoutside the Criatura main gate^000000.",
		},
		Summary = "Find the red grass outside the main gate",
	},
	[21005] = { -- iRO, corrected
		Title = "Save location!",
		Description = {
			"You received something nice.",
		},
		Summary = "",
	},
	[21006] = { -- iRO, corrected
		Title = "Good news for Leno",
		Description = {
			"It seems you just need to give Leno what you received from the healer.",
		},
		Summary = "Talk to Leno",
	},
	[21007] = { -- iRO, corrected
		Title = "First time meeting a friend",
		Description = {
			"You have made a good friend.",
		},
		Summary = "",
	},
	[21008] = { -- iRO, corrected
		Title = "First Battle",
		Description = {
			"You have been asked to catch the Poring that stole the ship's repair materials, recover 2 Wood, and deliver it to the sailor. Defeat Porings nearby and recover the Wood.",
		},
		Summary = "Deliver 2 Wood to the sailor",
	},
	[21009] = { -- iRO, corrected
		Title = "Sprakki's Call",
		Description = {
			"The guild has called for you, saying there is a request from the Eden Group. Meet <NAVI>[Sprakki]<INFO>iz_ac01,102,44,0,101,0</INFO></NAVI> at Criatura Academy in northern Izlude.",
		},
		Summary = "Talk to Sprakki",
	},
	[21011] = { -- iRO, corrected
		Title = "Liquor in the Well Bucket",
		Description = {
			"An old man in Payon asked you to pull up the liquor he left soaking in the well. Pull up the bucket of liquor from the well right next to him in one go.",
		},
		Summary = "Pull up the bucket from the well",
	},
	[21012] = { -- iRO, corrected
		Title = "The Grandson's Whereabouts",
		Description = {
			"You need to find an old man's grandson who snuck out of Archer Village in northern Payon. Ask the <NAVI>[guard in front of the cave]<INFO>pay_arche,41,133,0,101,0</INFO></NAVI> in Archer Village.",
		},
		Summary = "Talk to the guard at the cave",
	},
	[21013] = { -- iRO, corrected
		Title = "Found One, Lost Another",
		Description = {
			"Leno, who went looking for the grandson, is said to still be in the cave. You were asked for by name, so you can't refuse. Find <NAVI>[Leno]<INFO>pay_dun00,155,174,0,101,0</INFO></NAVI> in Payon Cave.",
		},
		Summary = "Talk to Leno in the cave",
	},
	[21014] = { -- iRO, corrected
		Title = "Smelly, slippery ghost",
		Description = {
			"Kill 5 Zombies in the area for <NAVI>[Leno]<INFO>pay_dun00,155,174,0,101,0</INFO></NAVI>, who is terrified of zombies.",
		},
		Summary = "Hunt Zombies for Leno",
	},
	[21015] = { -- iRO, corrected
		Title = "Undead War",
		Description = {
			"The Payon <NAVI>[guard]<INFO>pay_arche,41,133,0,101,0</INFO></NAVI> is overwhelmed by the growing number of Zombies and Skeletons. You have been asked to kill 10 Zombies and 20 Skeletons to reduce their numbers. Skeletons are said to appear only deeper in the cave.",
		},
		Summary = "Kill undead in Payon Cave",
		IconName = "ico_dq.bmp",
	},
	[21016] = { -- iRO, corrected
		Title = "Undead War - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board or the <NAVI>[guard]<INFO>pay_arche,41,133,0,101,0</INFO></NAVI> in Payon Archer Village.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21017] = { -- iRO, corrected
		Title = "Soul Purification Ritual",
		Description = {
			"To purify the vengeful spirits of a village that was buried and lost long ago, you need 'Soul Return Talismans'. Defeat Munak and Bongun to collect them. Munak and Bongun appear on Payon Cave Floor 3.",
		},
		Summary = "15 Soul Return Talismans",
		IconName = "ico_dq.bmp",
	},
	[21018] = { -- iRO, corrected
		Title = "Soul Purification Ritual - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board or the <NAVI>[guard]<INFO>pay_arche,38,134,0,101,0</INFO></NAVI> in Payon Archer Village.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21019] = { -- iRO, corrected
		Title = "Sorrow Soothed by a Cup of Liquor",
		Description = {
			"A monk of great spiritual power asks you to soothe the ghost fires with clear liquor and bring him 10 Last Breath. The clear liquor can be obtained from the <NAVI>[old man]<INFO>payon,192,109,0,101,0</INFO></NAVI> in Payon, and the ghost fires appear in the Abandoned Village on Payon Cave Floor 4.",
		},
		Summary = "10 Last Breath",
		IconName = "ico_dq.bmp",
	},
	[21020] = { -- iRO, corrected
		Title = "Sorrow Soothed by a Cup of Liquor - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21021] = { -- iRO, corrected
		Title = "Traces of Magic",
		Description = {
			"You don't know why a Girl's Handkerchief is needed to find traces of magic, but the <NAVI>[young scholar]<INFO>payon,198,111,0,101,0</INFO></NAVI> has asked you for 3 of them. Girl's Handkerchiefs can be obtained from Sohee, who appear in the Abandoned Village of Payon Cave.",
		},
		Summary = "3 Girl's Handkerchief",
		IconName = "ico_dq.bmp",
	},
	[21022] = { -- iRO, corrected
		Title = "Traces of Magic - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the <NAVI>[young scholar]<INFO>payon,198,111,0,101,0</INFO></NAVI> in Payon.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21025] = { -- official iRO
		Title = "A story from a long time ago",
		Description = {
			"You heard the story of the formation of the village of Payon from an elder.",
		},
		Summary = "",
	},
	[21026] = { -- iRO, corrected
		Title = "The anxious heart waiting for firewood",
		Description = {
			"A man says his son, who went to cut wood, hasn't come back. His son <NAVI>[Dong Dong]<INFO>pay_fild01,328,351,0,101,0</INFO></NAVI> seems to have gone to the forest south of Payon for firewood. Go find him.",
		},
		Summary = "Talk to the easygoing Dong Dong",
	},
	[21027] = { -- iRO, corrected
		Title = "It's just a tree",
		Description = {
			"To gather wood he has to hunt Willows for 'Barren Trunks', but he says it's too hard for him. Hunt 3 Willows in place of <NAVI>[Dong Dong]<INFO>pay_fild01,328,351,0,101,0</INFO></NAVI> and bring him 2 'Barren Trunks'.",
		},
		Summary = "2 Barren Trunks",
	},
	[21028] = { -- iRO, corrected
		Title = "Honeyed Labor",
		Description = {
			"You decided to gather wood in place of the son. Hunt 5 Willows in the forest south of Payon, get 3 'Barren Trunks', and turn them in at the Eden Group Board for the middle-aged man who is anxiously waiting.",
		},
		Summary = "3 Barren Trunks",
		IconName = "ico_dq.bmp",
	},
	[21029] = { -- iRO, corrected
		Title = "Honeyed Labor - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21030] = { -- iRO, corrected
		Title = "Action for Children",
		Description = {
			"Defeat the Boas from the forest east of Payon for the <NAVI>[young lady]<INFO>payon,217,94,0,101,0</INFO></NAVI> who is worried that the children will get hurt.",
		},
		Summary = "Hunt Boas",
	},
	[21031] = { -- iRO, corrected
		Title = "Professional Snake Hunter",
		Description = {
			"You decided to keep hunting Boas in the forest east of Payon. Defeat 5 Boas today.",
		},
		Summary = "Hunt Boas",
		IconName = "ico_dq.bmp",
	},
	[21032] = { -- iRO, corrected
		Title = "Professional Snake Hunter - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21033] = { -- iRO, corrected
		Title = "Strange Onion",
		Description = {
			"A <NAVI>[grandmother]<INFO>payon,237,64,0,101,0</INFO></NAVI> in Payon says she saw a strange-looking onion in the forest. She wants to check whether this onion, called a 'Wormtail', is a real onion, and asks you to hunt a Wormtail and get 1 'Scaly Stem'.",
		},
		Summary = "1 Scaly Stem",
	},
	[21034] = { -- iRO, corrected
		Title = "It's a noxious onion.",
		Description = {
			"Having found out that the Wormtail is a wicked thing that fools people, Grandma asked you to defeat them. Wormtails can be found in the forest east of Payon.",
		},
		Summary = "Hunt Wormtails",
		IconName = "ico_dq.bmp",
	},
	[21035] = { -- iRO, corrected
		Title = "It's a noxious onion. - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21036] = { -- iRO, corrected
		Title = "Strange Mushroom",
		Description = {
			"A <NAVI>[grandfather]<INFO>payon,239,64,0,101,0</INFO></NAVI> in Payon says he saw a suspicious mushroom in the eastern forest. Sure that it is an evil creature, he asked you to defeat the mushroom called 'Spore'.",
		},
		Summary = "Hunt Spores",
	},
	[21037] = { -- iRO, corrected
		Title = "Before It's Overrun with Mushrooms",
		Description = {
			"A grandfather in Payon seems alarmed by how fast Spores multiply. He asks you to defeat them before the eastern forest is covered with Spores. Hunt the Spores!",
		},
		Summary = "Hunt Spores",
		IconName = "ico_dq.bmp",
	},
	[21038] = { -- iRO, corrected
		Title = "Before It's Overrun with Mushrooms - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21039] = { -- iRO, corrected
		Title = "I'm Counting on You!",
		Description = {
			"You ended up gathering wood in place of Dong Dong. Anyway, visit <NAVI>[Dong Dong's father]<INFO>payon,173,77,0,101,0</INFO></NAVI>, who must be waiting for news, and tell him what happened.",
		},
		Summary = "Talk to a nervous middle-aged man",
	},
	[21040] = { -- iRO, corrected
		Title = "Prisoners Dreaming of Escape",
		Description = {
			"In the underground prison of Glast Heim Castle, prisoners who had already died have been revived as undead by dark energy and now roam freely. Priest Karon, exhausted from dealing with the endless zombies, asked you to defeat Skeleton Prisoners and Zombie Prisoners.",
		},
		Summary = "Defeat Skeleton Prisoners and Zombie Prisoners",
		IconName = "ico_dq.bmp",
	},
	[21041] = { -- iRO, corrected
		Title = "Prisoners Dreaming of Escape - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21042] = { -- iRO, corrected
		Title = "Vicious Torturer",
		Description = {
			"Demons are said to have slipped out under cover of the chaos and to be roaming the Glast Heim underground prison. Nadir struggled to help Karon, but it was not enough. Nadir asked you to defeat Rybio.",
		},
		Summary = "Defeat Rybio",
		IconName = "ico_dq.bmp",
	},
	[21043] = { -- iRO, corrected
		Title = "Vicious Torturer - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21044] = { -- iRO, corrected
		Title = "Fine Taste",
		Description = {
			"Demons are said to have slipped out under cover of the chaos and to be roaming the Glast Heim underground prison. Nadir struggled to help Karon, but it was not enough. Nadir asked you to defeat Injustice.",
		},
		Summary = "Defeat Injustice",
		IconName = "ico_dq.bmp",
	},
	[21045] = { -- iRO, corrected
		Title = "Fine Taste - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21046] = { -- iRO, corrected
		Title = "Young Scholar's taste",
		Description = {
			"The <NAVI>[young scholar]<INFO>payon,198,111,0,101,0</INFO></NAVI> seems to have strange tastes, but you will probably be seeing a lot of him from now on.",
		},
		Summary = "",
	},
	[21047] = { -- iRO, corrected
		Title = "Moscovia's Nightmare",
		Description = {
			"Many kinds of fairies are said to live ^4d4dffdeep in the forests of Moscovia^000000. This is a request to ^4d4dffdefeat the Kikimora^000000, which frightens and torments passersby. Moscovia can be reached by boat from Alberta.",
		},
		Summary = "Defeat Kikimora",
		IconName = "ico_dq.bmp",
	},
	[21048] = { -- iRO, corrected
		Title = "Moscovia's Nightmare - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21049] = { -- iRO, corrected
		Title = "Beautiful Doll",
		Description = {
			"This is a request to defeat the ^4d4fffMiyabi Doll^000000, a demon that bewitches people with its beautiful looks, in the ^4d4dffTatami Maze inside Amatsu's Tenshukaku^000000. Amatsu can be reached by boat from Alberta.",
		},
		Summary = "Defeat Miyabi Doll",
		IconName = "ico_dq.bmp",
	},
	[21050] = { -- iRO, corrected
		Title = "Beautiful Doll - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
