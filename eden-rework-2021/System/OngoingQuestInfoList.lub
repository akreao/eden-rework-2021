		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21227] = { -- official iRO
		Title = "People in Trouble 1",
		Description = {
			"A university student who came to Byalan Island for research seems to be in trouble and has requested that someone be sent to help. Take a boat from the Izlude harbor to Byalan Island, then meet <NAVI>[University Student Helden]<INFO>izlu2dun,105,68,0,101,0</INFO></NAVI>.",
		},
		Summary = "Talk to University Student Helden",
	},
	[21228] = { -- iRO, corrected
		Title = "Collecting Samples Is the Hardest Part of Biology",
		Description = {
			"University Student Helden says he needs biological specimens, but is too scared to enter the dungeon. He asks you to hunt the Marina and Plankton found mainly on <NAVI>[Izlude Underwater Cave Dungeon Floor 1]<INFO>iz_dun00,168,166,0,101,0</INFO></NAVI> and bring him the specimen 'Single Cell'.",
		},
		Summary = "10 Single Cells",
		IconName = "ico_dq.bmp",
	},
	[21229] = { -- iRO, corrected
		Title = "Collecting Samples Is the Hardest Part of Biology - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21230] = { -- iRO, corrected
		Title = "Profiting from the Fray",
		Description = {
			"Learning that Helden had asked you to enter the Izlude dungeon, the <NAVI>[Wandering General Merchant]<INFO>izlu2dun,108,68,0,101,0</INFO></NAVI> nearby made a request too. He says he'll reward you if you bring him 5 Nippers obtained by defeating Vadon.",
		},
		Summary = "5 Nippers",
	},
	[21231] = { -- iRO, corrected
		Title = "Row While the Tide Is In",
		Description = {
			"The Wandering General Merchant thinks the tweezers he made from Nippers could become a hit item, and asks you to bring him more Nippers. Vadon mainly appear on <NAVI>[Izlude Underwater Cave Dungeon Floor 2]<INFO>iz_dun01,252,250,0,101,0</INFO></NAVI>.",
		},
		Summary = "5 Nippers",
		IconName = "ico_dq.bmp",
	},
	[21232] = { -- iRO, corrected
		Title = "Row While the Tide Is In - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21233] = { -- iRO, corrected
		Title = "No News Is Good News..? 1",
		Description = {
			"Ernest, one of the Juno students who came on a group investigation, is uneasy because he hasn't heard from the other team members while resting from his injury. Go to Izlude Underwater Cave Dungeon Floor 3, find the team members and <NAVI>[Team Leader Maxim]<INFO>iz_dun02,229,231,0,101,0</INFO></NAVI>, and give them Ernest's message.",
		},
		Summary = "Talk to Team Leader Maxim",
	},
	[21234] = { -- iRO, corrected
		Title = "The Extreme Chef",
		Description = {
			"Team member <NAVI>[Kusekili]<INFO>iz_dun02,228,229,0,101,0</INFO></NAVI> isn't investigating the dungeon at all and can only think about cooking. He says securing just one ingredient in the dungeon will make an amazing dish. He asks you to defeat Marse and get him some Squid Ink.",
		},
		Summary = "10 Squid Ink",
	},
	[21235] = { -- iRO, corrected
		Title = "The Woman in the Illusion",
		Description = {
			"Team member Nonda Ancana is completely drunk and keeps talking about a woman met while drunk, but no matter how you listen, it's an Obeaune. Nonda Ancana asks you to confirm whether that woman was really an Obeaune. Defeat an Obeaune and show a Heart of Mermaid as proof.",
		},
		Summary = "1 Heart of Mermaid",
		IconName = "ico_dq.bmp",
	},
	[21236] = { -- iRO, corrected
		Title = "No News Is Good News..? 2",
		Description = {
			"Kusekili and the team members ask you to deliver the Frog Egg Squid Ink Soup they made to their teammate <NAVI>[Ernest]<INFO>iz_dun01,121,158,0,101,0</INFO></NAVI>. \"We're fine!\" Just deliver it for now.",
		},
		Summary = "Deliver the Squid Ink Soup to Ernest",
	},
	[21237] = { -- iRO, corrected
		Title = "Consideration for a Friend",
		Description = {
			"Ernest is angry at his teammates' idle behavior, yet seems somehow touched that they look after him. So the team can investigate in peace, he asks you to get rid of the threatening Swordfish and Marc on <NAVI>[Izlude Underwater Cave Dungeon Floor 4]<INFO>iz_dun03,37,64,0,101,0</INFO></NAVI>.",
		},
		Summary = "Defeat Swordfish and Marc",
		IconName = "ico_dq.bmp",
	},
	[21238] = { -- iRO, corrected
		Title = "Consideration for a Friend - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21239] = { -- iRO, corrected
		Title = "Procuring Cooking Ingredients",
		Description = {
			"Team member Kusekili isn't investigating the dungeon at all and can only think about cooking. He says securing just one ingredient in the dungeon will make an amazing dish. He asks you to defeat Marse and get him some Squid Ink.",
		},
		Summary = "10 Squid Ink",
		IconName = "ico_dq.bmp",
	},
	[21240] = { -- iRO, corrected
		Title = "Procuring Cooking Ingredients - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21241] = { -- iRO, corrected
		Title = "Proof of the Sea God",
		Description = {
			"<NAVI>[Team Leader Maxim]<INFO>iz_dun02,229,231,0,101,0</INFO></NAVI> is making a fuss, claiming he saw the sea god Poseidon in the <NAVI>[Izlude Underwater Cave Dungeon Floor 5]<INFO>iz_dun04,28,35,0,101,0</INFO></NAVI> deep beneath the undersea dungeon. But those are said to be monsters called Strouf and Merman, so he wants proof that they're monsters. Bring him a Fin and Ancient Lips to show him.",
		},
		Summary = "1 Fin, 1 Ancient Lips",
	},
	[21242] = { -- iRO, corrected
		Title = "Annoying Watchmen",
		Description = {
			"After learning that Strouf was not the god of the sea, Team Leader Maxim wants to visit the Underground Shrine on <NAVI>[Izlude Underwater Cave Dungeon Floor 5]<INFO>iz_dun04,28,35,0,101,0</INFO></NAVI>. However, he says that the ever-present Strouf and Merman are causing too much trouble, and asks you to defeat them.",
		},
		Summary = "Defeat Strouf and Merman",
		IconName = "ico_dq.bmp",
	},
	[21243] = { -- iRO, corrected
		Title = "Annoying Watchmen - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21244] = { -- iRO, corrected
		Title = "The Woman in the Illusion - Cooldown",
		Description = {
			"This is a daily quest and can be accepted and completed again once the cooldown expires. The quest can be obtained from the Eden Group Board.",
		},
		Summary = "Resets at 04:00",
		IconName = "ico_dq.bmp",
		CoolTimeQuest = 1,
	},
	[21246] = { -- iRO, corrected
		Title = "Are You Strong? 1",
		Description = {
			"Outside Prontera's west gate, a boy named <NAVI>[Paul]<INFO>prt_fild05,353,221,0,101,0</INFO></NAVI> asked whether you were strong. If so, he wanted to know if you could defeat Hornets. Bees escaped from a hive that was accidentally knocked over and became wild, making the area dangerous. He had apparently been told not to play outside. Defeat the Hornets and protect the playground.",
		},
		Summary = "Defeat Hornets",
	},
	[21247] = { -- iRO, corrected
		Title = "Are You Strong? 2",
		Description = {
			"This is a request from <NAVI>[Paul]<INFO>prt_fild05,353,221,0,101,0</INFO></NAVI> outside Prontera's west gate. A huge grasshopper colony lives directly south, and no one knows when they might invade the western field. Protect the western field from this unseen threat. Defeat Rockers in <NAVI>[Prontera Field 07]<INFO>prt_fild07,251,364,0,101,0</INFO></NAVI> to the southwest and put his mind at ease.",
		},
		Summary = "Defeat Rockers",
	},
	[21248] = { -- iRO, corrected
		Title = "Are You Strong? 3",
		Description = {
			"This is a request from a girl named Anne outside Prontera's west gate. She heard from someone named Hohenhallhoch that the terrifying knight Ambernite might be advancing toward Prontera from <NAVI>[Prontera Field 04]<INFO>prt_fild04,380,160,0,101,0</INFO></NAVI> to the west. Stop Ambernite and put her mind at ease.",
		},
		Summary = "Defeat Ambernite",
	},
	[21249] = { -- iRO, corrected
		Title = "Playground Stabilization Operation - Hornets",
		Description = {
			"Outside Prontera's west gate, a boy named Paul asked whether you were strong. If so, he wanted to know if you could defeat Hornets. Bees escaped from a hive that was accidentally knocked over and became wild, making the area dangerous. He had apparently been told not to play outside. Defeat the Hornets and protect the playground.",
		},
		Summary = "Defeat Hornets",
		IconName = "ico_dq.bmp",
	},
	[21250] = { -- iRO, corrected
		Title = "Playground Stabilization Operation - Rockers",
		Description = {
