		IconName = "ico_dq.bmp",
	},
	[21113] = { -- iRO, corrected
		Title = "The Sky Petite Is Cute",
		Description = {
			"The <NAVI>[Petite Boy]<INFO>geffen,40,133,0,101,0</INFO></NAVI> says the Petites are far too aggressive for him to approach, and asks you to find a friendly one for him instead. Go to the Sky Petite habitat in <NAVI>[Geffen Field 08]<INFO>gef_fild08,357,187,0,101,0</INFO></NAVI>, try touching the Petites, and bring back one that doesn't attack. If a Petite attacks you, you'll have no choice but to fight back!",
